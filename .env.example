# Telegram Access Manager – server-side secrets (placeholders only).
# Copy to your secret store (Dokploy "Environment" / Docker secrets). Never commit real values.
# These must be available to the web, worker and scheduler processes.

# Token from @BotFather, format <digits>:<secret>
TELEGRAM_BOT_TOKEN=000000000:REPLACE_WITH_TOKEN_FROM_BOTFATHER_xxxxxxxx

# 32-256 chars of A-Z a-z 0-9 _ -  (generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))")
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING_32_CHARS_MIN
